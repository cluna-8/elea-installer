#!/usr/bin/env bash
# curl de mentira para las pruebas del instalador. Sin FAKE_CURL=1 pasa al curl de verdad (las demás pruebas
# no lo notan). Con FAKE_CURL=1 contesta según la ruta: registra cada llamada en ${FAKE_LOG}.curl y
#   /api/v1/internal/*       → $FAKE_HTTP_INTERNAL (404: el proxy lo niega, como debe)
#   /api/v1/redirect/health  → $FAKE_HTTP_REDIRECT (200; con otro código, cuerpo {"status":"degraded","reason":"region_unresolved"})
#   /health                  → $FAKE_HTTP_HEALTH (200)
if [ "${FAKE_CURL:-}" != 1 ]; then
  aqui="$(cd "$(dirname "$0")" && pwd)"
  PATH="$(printf %s "$PATH" | tr ':' '\n' | grep -vxF "$aqui" | paste -sd:)" exec curl "$@"
fi
salida=""; escribe=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) salida="$2"; shift ;;
    -w) escribe="$2"; shift ;;
    --max-time) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done
echo "curl $url" >> "${FAKE_LOG:?}.curl"
case "$url" in
  */api/v1/internal/*)      code="${FAKE_HTTP_INTERNAL:-404}"; cuerpo="" ;;
  */api/v1/redirect/health) code="${FAKE_HTTP_REDIRECT:-200}"
    if [ "$code" = 200 ]; then cuerpo='{"status":"ok"}'; else cuerpo='{"status":"degraded","reason":"region_unresolved"}'; fi ;;
  */health)                 code="${FAKE_HTTP_HEALTH:-200}"; cuerpo='{"status":"ok"}' ;;
  *)                        code=200; cuerpo="" ;;
esac
if [ -n "$salida" ] && [ "$salida" != /dev/null ]; then printf '%s' "$cuerpo" > "$salida"; fi
[ -z "$escribe" ] || printf '%s' "${escribe//%\{http_code\}/$code}"
[ -n "$escribe" ] || printf '%s' "$cuerpo"
case "$code" in 2*) exit 0 ;; *) exit 0 ;; esac
