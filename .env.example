# NO editar los nombres de la izquierda. `./install.sh` completa los valores vacíos
# de secretos automáticamente la primera vez que corre — lo único que tenés que
# escribir vos son las 3 credenciales de Azure OpenAI (o Gemini) de abajo.

POSTGRES_DB=elea_gateway
POSTGRES_USER=elea_admin
POSTGRES_PASSWORD=

# Base PROPIA del motor de gateway (la crea `db-engine-init` sola, idempotente). No compartirla con
# POSTGRES_DB: el migrador del motor borra las tablas ajenas a él. En una instalación vieja con base
# compartida, `./install.sh` la migra (./migrar-base-motor.sh); ver README.
ENGINE_DB=elea_engine

ENGINE_MASTER_KEY=
FERNET_SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_PASSWORD=

# Región de detección de datos personales (DNI/CUIL/CBU para Argentina).
ENTITY_REGION=latam_ar

# Bóveda de PII: permite que el chat RAG restaure el dato real (DNI, email, teléfono,
# nombre, CBU) en su respuesta al usuario autorizado, igual que ya hace el chat
# directo — sin esto, un documento enmascarado queda con los placeholders sin
# resolver para siempre en el RAG. Guarda el mapa reversible en Redis con TTL
# (90 días default). Podés apagarlo (false) si preferís que el enmascarado en
# documentos sea irreversible para siempre (más estricto para compliance).
SENTINEL_PII_VAULT_ENABLED=true
SENTINEL_PII_VAULT_TTL_SECONDS=7776000

# ── Completar vos: credenciales reales del modelo ────────────────────────────────
# Azure OpenAI (recomendado, es lo que usa Elea hoy):
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=
# Nombre del DESPLIEGUE de embeddings en ese recurso (lo elige quien lo creó; NO es el nombre del modelo).
# Lo usa el ruteo semántico. Vacío = text-embedding-3-large. En Elea: text-embedding-3-large-azure-openai
# (cómo listar los despliegues del recurso: README, «Despliegue de embeddings del ruteo»).
ROUTER_EMBEDDINGS_DEPLOYMENT=
# Alternativa/adicional: Gemini
GEMINI_API_KEY=

# Estas las completa install.sh solo, en el primer arranque (no tocar a mano):
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_PROVIDER_VIRTUAL_KEY=
TABULAR_ENGINE_VIRTUAL_KEY=
PRESENTON_ENGINE_VIRTUAL_KEY=
TABULAR_INTERNAL_TOKEN=

# Modelo que usan los motores de documentos, planillas y presentaciones (nombre real del catálogo).
ANYTHINGLLM_MODEL=azure-gpt-4o-mini
TABULAR_MODEL=azure-gpt-5.4-mini
PRESENTON_MODEL=azure-gpt-5.4-mini

# Imagen del motor: está FIJADA POR DIGEST en docker-compose.yml y nunca se mueve sola. Para subirla
# a propósito, descomentar y pegar la referencia que imprime publish-elea.sh (`PINNED …=<imagen>@sha256:…`)
# — con copia previa, ver README ("Subir la versión del motor").
# ENGINE_IMAGE=ghcr.io/cluna-8/elea-guardian-engine@sha256:<digest>

# ── Extensión de redirección de modelos (opcional, APAGADA por defecto) ───────────────────────────
# Para activarla (servidor de Elea: ver README, «Extensión de redirección de modelos»): descomentar las dos
# primeras líneas y correr ./install.sh. Se apaga sacando ELEA_REDIRECT. Las llaves que necesita las genera el
# instalador en un archivo FUERA del repo (modo 600): no se escriben acá.
# ELEA_REDIRECT=1
# ELEA_EXT_VERSION=AAAA-MM-DD            # versión publicada con sus imágenes -ext (obligatoria, sin default)
# Opcionales: otra ruta para ese archivo (absoluta, fuera del repo) y imágenes -ext por digest.
# ELEA_REDIRECT_ENV_FILE=/ruta/absoluta/redirect.env
# BACKEND_EXT_IMAGE=ghcr.io/cluna-8/elea-guardian-backend@sha256:<digest>
# FRONTEND_EXT_IMAGE=ghcr.io/cluna-8/elea-guardian-frontend@sha256:<digest>
# ENGINE_EXT_IMAGE=ghcr.io/cluna-8/elea-guardian-engine@sha256:<digest>

# ── HTTPS del proxy (Claude Desktop exige https en la URL de la pasarela) ────────────────────────
# El proxy publica HTTP en el 8091 (como siempre) y HTTPS en PROXY_HTTPS_PORT. ./install.sh completa solo lo que
# falte de estas líneas; README, «HTTPS para Claude Desktop».
# Puerto HTTPS publicado en el servidor (por defecto 8443).
# PROXY_HTTPS_PORT=8443
# IP y/o nombres DNS con que las PC llegan al servidor, separados por coma y sin espacios: van en el certificado y
# en la URL. Por defecto: la IP del servidor y su hostname. Con certificado de la empresa, los nombres de ese certificado.
# PROXY_TLS_NAMES=172.16.0.120,elea-srv
# Certificado de la empresa (RECOMENDADO): rutas ABSOLUTAS de archivos del servidor, FUERA de este repo, las dos juntas.
# Se montan de solo lectura. Sin ellas, el proxy usa su CA interna y ./exportar-ca.sh exporta su raíz pública.
# PROXY_TLS_CERT=/etc/ssl/elea/elea.crt
# PROXY_TLS_KEY=/etc/ssl/elea/elea.key

# URL pública de la pasarela para los kits de cliente (Modelos → Kits). Con la extensión de redirección activa y
# sin valor aquí, el instalador usa https://<primer nombre de PROXY_TLS_NAMES>:<PROXY_HTTPS_PORT>/api/v1/gw. Si el
# host es interno de compose (backend:8000), el panel pone un marcador y avisa. Ponerla acá la fija (la que
# alcanzan las PC, con su puerto):
# REDIRECT_GATEWAY_URL=https://172.16.0.120:8443/api/v1/gw
